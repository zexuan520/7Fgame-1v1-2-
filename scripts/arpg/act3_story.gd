static func villages() -> Array:
	return Game.save.get("arpg_villages", [])


## 认下一条村名：返回下标（都认齐了返回 -1）。认的顺序固定从第一条往后
static func take_village() -> int:
	var got: Array = villages().duplicate()
	for i in range(VILLAGES.size()):
		if not got.has(i):
			got.append(i)
			Game.save["arpg_villages"] = got
			Game.write_save()
			return i
	return -1


static func villages_done() -> bool:
	return villages().size() >= VILLAGES.size()
