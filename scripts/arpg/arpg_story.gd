]


static func pages() -> Array:
	return Game.save.get("arpg_pages", [])


static func has_all_pages() -> bool:
	return pages().size() >= PAGES.size()


## 下一页还没捡到的残页（-1 表示全齐了）
static func next_page() -> int:
	var got := pages()
	for i in range(PAGES.size()):
		if not got.has(i):
			return i
	return -1


static func take_page(i: int) -> void:
	var got: Array = pages().duplicate()
	if not got.has(i):
		got.append(i)
	Game.save["arpg_pages"] = got
	Game.write_save()


static func encounter_for(floor_i: int, flags: Dictionary, seen: Dictionary) -> Dictionary:
	# 先挑一次都没见过的（存档 arpg_enc_seen），都见过了再按顺序来：这样同一层的几段遭遇会轮着出现
	var ever: Array = Game.save.get("arpg_enc_seen", [])
	var first := {}
	for e: Dictionary in ENCOUNTERS:
		if int(e["floor"]) != floor_i or seen.has(e["id"]):
			continue
		if e.has("need") and not flags.has(e["need"]):
			continue
		if e.has("save_need") and not save_cond(String(e["save_need"])):
			continue
		if e.has("save_need") or not ever.has(e["id"]):
			return e
		if first.is_empty():
			first = e
	return first


## 拾骨婆说身世的条件：看过灯冢壁画 + 井底枯荣选过（灯片或带他出井），还没说过
static func hag_reveal_ready() -> bool:
	var sv := Game.save
	return bool(sv.get("arpg_hag_mural", false)) and not bool(sv.get("arpg_hag_told", false)) \
		and (bool(sv.get("arpg_shard", false)) or bool(sv.get("arpg_kurong_freed", false)))


static func mark_seen(id: String) -> void:
	var ever: Array = (Game.save.get("arpg_enc_seen", []) as Array).duplicate()
	if not ever.has(id):
		ever.append(id)
		Game.save["arpg_enc_seen"] = ever


