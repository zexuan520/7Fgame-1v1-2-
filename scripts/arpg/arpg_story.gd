const ALL_SOULS_NEED := ["ronin_saved", "jizo_paid", "sakura_rest", "graves_named", "monk_told"]


static func all_souls(flags: Dictionary) -> bool:
	for f: String in ALL_SOULS_NEED:
		if not flags.has(f):
			return false
	return true


