## 该说的下一句碎念（没有就返回 -1）
static func next_mutter() -> int:
	var heard := int(Game.save.get("arpg_mutter", 0))
	if heard >= MUTTERS.size() or int(Game.save.get("deaths", 0)) < MUTTER_AT[heard]:
		return -1
	return heard


